{
  "name": "g0d-tweaks",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "powershell -Command \"Start-Process powershell -Verb RunAs -ArgumentList '-NoExit', '-Command', \\\"Set-Location '$((Get-Location).Path)'; npm run tauri dev\\\"\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/test-bench.test.mjs",
    "test:bench": "node scripts/test-bench.mjs",
    "dev:staging": "tauri dev --config src-tauri/tauri.staging.conf.json",
    "build:staging": "tauri build --config src-tauri/tauri.staging.conf.json",
    "release": "node scripts/publish.mjs",
    "release:current": "node scripts/publish.mjs --current",
    "release:beta": "node scripts/publish.mjs --beta",
    "release:promote": "node scripts/publish.mjs --promote",
    "tauri": "tauri"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "libsodium-wrappers": "^0.8.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
