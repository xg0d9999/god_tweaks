{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "g0d suite",
  "version": "1.0.8",
  "identifier": "com.godtweaks.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "g0d suite",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "windowEffects": {
          "effects": [
            "acrylic",
            "mica"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2QjJDMkNFRkQyOEJFN0IKUldSN3Zpajl6c0t5SnFYb256aVRHR2R4cVN4S0I2RWdMbDBZcUxBQ1pqZzNzei9DUkV6dWhNeGUK",
      "endpoints": [
        "https://github.com/xg0d9999/god_suite_releases/releases/latest/download/latest.json"
      ]
    }
  }
}
