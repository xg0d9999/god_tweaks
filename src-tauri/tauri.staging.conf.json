{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "g0d suite Staging",
  "identifier": "com.godtweaks.staging",
  "app": {
    "windows": [
      {
        "title": "g0d suite - Lab Staging",
        "width": 940,
        "height": 940,
        "minWidth": 800,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "devtools": true,
        "windowEffects": {
          "effects": [
            "acrylic",
            "mica"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xg0d9999/god_tweaks/releases/download/staging/latest-staging.json"
      ]
    }
  }
}
